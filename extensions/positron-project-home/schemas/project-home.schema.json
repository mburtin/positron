{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Positron Project Home",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"title": { "type": "string" },
		"description": { "type": "string" },
		"tags": { "type": "array", "items": { "type": "string" } },
		"banner": { "type": "string", "description": "Project-relative path to a PNG, JPEG, GIF, WebP or AVIF image." },
		"tasks": { "type": "array", "items": { "$ref": "#/definitions/task" } },
		"manuscript": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"file": { "type": "string", "description": "Project-relative path to the manuscript." },
				"status": { "type": "string" },
				"sections": { "type": "array", "items": { "$ref": "#/definitions/checklistItem" } },
				"completedChapters": {
					"type": "array",
					"description": "Paths relative to the Quarto book for chapters marked complete.",
					"uniqueItems": true,
					"items": { "type": "string" }
				}
			}
		},
		"milestones": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["title"],
				"additionalProperties": false,
				"properties": {
					"title": { "type": "string" },
					"date": { "type": "string", "format": "date" },
					"done": { "type": "boolean", "default": false, "description": "Legacy completion status for a milestone without a tasks list." },
					"tasks": {
						"type": "array",
						"description": "Tasks in this milestone. Its progress is calculated from these tasks.",
						"items": { "$ref": "#/definitions/task" }
					}
				}
			}
		},
		"members": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["name"],
				"additionalProperties": false,
				"properties": {
					"name": { "type": "string" },
					"role": { "type": "string" }
				}
			}
		},
		"links": {
			"type": "array",
			"description": "HTTPS shortcuts shown in Quick Links. Legacy project-relative file shortcuts appear in Documentation.",
			"items": {
				"type": "object",
				"required": ["label", "target"],
				"additionalProperties": false,
				"properties": {
					"label": { "type": "string" },
					"target": { "type": "string", "description": "An HTTPS URL without credentials." }
				}
			}
		},
		"documents": {
			"type": "array",
			"description": "Pinned files shown in Documentation.",
			"items": { "$ref": "#/definitions/fileShortcut" }
		},
		"data": {
			"type": "array",
			"description": "Pinned files shown first in Data.",
			"items": { "$ref": "#/definitions/fileShortcut" }
		}
	},
	"definitions": {
		"fileShortcut": {
			"type": "object",
			"required": ["label", "target"],
			"additionalProperties": false,
			"properties": {
				"label": { "type": "string" },
				"target": { "type": "string", "description": "A path to a file relative to the project folder." }
			}
		},
		"task": {
			"type": "object",
			"required": ["title"],
			"additionalProperties": false,
			"properties": {
				"title": { "type": "string" },
				"done": { "type": "boolean", "default": false },
				"tag": { "type": "string" },
				"notes": { "type": "string", "description": "Multiline notes for the task." }
			}
		},
		"checklistItem": {
			"type": "object",
			"required": ["title"],
			"additionalProperties": false,
			"properties": {
				"title": { "type": "string" },
				"done": { "type": "boolean", "default": false },
				"tag": { "type": "string" }
			}
		}
	}
}
